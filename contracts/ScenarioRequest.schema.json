{
  "$defs": {
    "Assumptions": {
      "additionalProperties": false,
      "properties": {
        "cost_exposure": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Cost Exposure",
          "type": "string"
        },
        "effective_price_shock": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Effective Price Shock",
          "type": "string"
        },
        "customer_pass_through": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Customer Pass Through",
          "type": "string"
        },
        "basis": {
          "enum": [
            "user_assumption",
            "research_assumption"
          ],
          "title": "Basis",
          "type": "string"
        },
        "acknowledged": {
          "const": true,
          "title": "Acknowledged",
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "cost_exposure",
        "effective_price_shock",
        "customer_pass_through",
        "basis",
        "acknowledged"
      ],
      "title": "Assumptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "minimum": 1,
      "title": "Dataset Version",
      "type": "integer"
    },
    "revenue_fact_id": {
      "title": "Revenue Fact Id",
      "type": "string"
    },
    "cost_fact_id": {
      "title": "Cost Fact Id",
      "type": "string"
    },
    "revenue_revision": {
      "minimum": 1,
      "title": "Revenue Revision",
      "type": "integer"
    },
    "cost_revision": {
      "minimum": 1,
      "title": "Cost Revision",
      "type": "integer"
    },
    "model_version": {
      "const": "static-gross-profit-v1",
      "title": "Model Version",
      "type": "string"
    },
    "assumptions": {
      "$ref": "#/$defs/Assumptions"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "revenue_fact_id",
    "cost_fact_id",
    "revenue_revision",
    "cost_revision",
    "model_version",
    "assumptions"
  ],
  "title": "ScenarioRequest",
  "type": "object"
}
